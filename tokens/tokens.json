{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "HoopsFoundry UI",
    "version": "1.0.0",
    "description": "Tokens für Digitaler Spielbericht & Schwester-Apps",
    "accessibility": "WCAG 2.1 AAA",
    "identity": "BBV Ink/Amber/Sky (default) · DBB Schwarz/Gold/Orange via data-brand=\"dbb\" (see color.role)"
  },

  "color": {
    "ink": {
      "0":    { "$value": "oklch(1.000 0 0)" },
      "50":   { "$value": "oklch(0.985 0.003 60)" },
      "100":  { "$value": "oklch(0.965 0.005 60)" },
      "200":  { "$value": "oklch(0.925 0.007 60)" },
      "300":  { "$value": "oklch(0.850 0.009 60)" },
      "400":  { "$value": "oklch(0.700 0.011 60)" },
      "500":  { "$value": "oklch(0.560 0.012 60)" },
      "600":  { "$value": "oklch(0.420 0.013 60)", "$description": "Body text — AAA on white (~7.2:1)" },
      "700":  { "$value": "oklch(0.300 0.012 60)", "$description": "Deep text" },
      "800":  { "$value": "oklch(0.200 0.010 60)", "$description": "Button fill" },
      "900":  { "$value": "oklch(0.130 0.008 60)", "$description": "Strong text" },
      "1000": { "$value": "oklch(0.020 0.004 60)", "$description": "Dark surface" }
    },
    "amber": {
      "50":  { "$value": "oklch(0.975 0.025 83)" },
      "100": { "$value": "oklch(0.940 0.060 83)" },
      "200": { "$value": "oklch(0.880 0.110 83)" },
      "300": { "$value": "oklch(0.830 0.145 83)" },
      "400": { "$value": "oklch(0.800 0.165 83)", "$description": "Anchor · fill, CTA, clock" },
      "500": { "$value": "oklch(0.760 0.165 83)" },
      "600": { "$value": "oklch(0.660 0.150 78)" },
      "700": { "$value": "oklch(0.540 0.130 73)" },
      "800": { "$value": "oklch(0.420 0.110 63)", "$description": "AAA text on white" },
      "900": { "$value": "oklch(0.290 0.080 58)" }
    },
    "sky": {
      "50":  { "$value": "oklch(0.975 0.018 244)" },
      "100": { "$value": "oklch(0.940 0.045 244)" },
      "200": { "$value": "oklch(0.880 0.080 244)" },
      "300": { "$value": "oklch(0.820 0.110 244)" },
      "400": { "$value": "oklch(0.760 0.125 244)", "$description": "Anchor · fill" },
      "500": { "$value": "oklch(0.680 0.140 246)" },
      "600": { "$value": "oklch(0.560 0.140 249)" },
      "700": { "$value": "oklch(0.450 0.135 252)", "$description": "Default heim color" },
      "800": { "$value": "oklch(0.345 0.120 256)", "$description": "AAA text on white" },
      "900": { "$value": "oklch(0.230 0.080 259)" }
    },
    "neutral": {
      "0":    { "$value": "oklch(1.000 0 0)" },
      "50":   { "$value": "oklch(0.985 0.003 250)" },
      "100":  { "$value": "oklch(0.965 0.005 250)" },
      "200":  { "$value": "oklch(0.925 0.006 250)" },
      "300":  { "$value": "oklch(0.860 0.008 250)" },
      "400":  { "$value": "oklch(0.700 0.010 250)" },
      "500":  { "$value": "oklch(0.520 0.011 250)" },
      "600":  { "$value": "oklch(0.420 0.011 250)", "$description": "Muted text — AAA on white" },
      "700":  { "$value": "oklch(0.320 0.010 250)" },
      "800":  { "$value": "oklch(0.215 0.009 250)" },
      "900":  { "$value": "oklch(0.145 0.008 250)" },
      "950":  { "$value": "oklch(0.085 0.006 250)" },
      "1000": { "$value": "oklch(0.025 0.004 250)" }
    },
    "semantic": {
      "success": {
        "fill": { "$value": "oklch(0.640 0.150 150)" },
        "text": { "$value": "oklch(0.400 0.130 150)" },
        "soft": { "$value": "oklch(0.960 0.040 150)" }
      },
      "warning": {
        "fill": { "$value": "oklch(0.770 0.165 75)" },
        "text": { "$value": "oklch(0.420 0.120 60)" },
        "soft": { "$value": "oklch(0.970 0.055 80)" }
      },
      "error": {
        "fill":   { "$value": "oklch(0.580 0.220 27)", "$description": "Foul dots / non-text indicators" },
        "button": { "$value": "oklch(0.400 0.190 27)", "$description": "AAA: white-on-fill" },
        "text":   { "$value": "oklch(0.420 0.180 27)" },
        "soft":   { "$value": "oklch(0.955 0.045 27)" }
      },
      "info": {
        "fill": { "$value": "oklch(0.620 0.140 245)" },
        "text": { "$value": "oklch(0.380 0.130 245)" },
        "soft": { "$value": "oklch(0.955 0.035 245)" }
      }
    },
    "gold": {
      "50": { "$value": "oklch(0.975 0.020 90)" },
      "100": { "$value": "oklch(0.945 0.040 90)" },
      "200": { "$value": "oklch(0.900 0.065 90)" },
      "300": { "$value": "oklch(0.830 0.085 90)" },
      "400": { "$value": "oklch(0.759 0.099 90)", "$description": "Anchor ≈ #c9ae64 · DBB-Gold (Markenfarbe, CTA)" },
      "500": { "$value": "oklch(0.690 0.100 90)" },
      "600": { "$value": "oklch(0.610 0.095 90)" },
      "700": { "$value": "oklch(0.510 0.085 90)" },
      "800": { "$value": "oklch(0.420 0.072 90)", "$description": "Text AAA" },
      "900": { "$value": "oklch(0.290 0.050 90)" }
    },
    "orange": {
      "50": { "$value": "oklch(0.975 0.020 65)" },
      "100": { "$value": "oklch(0.945 0.045 65)" },
      "200": { "$value": "oklch(0.895 0.085 65)" },
      "300": { "$value": "oklch(0.840 0.130 65)" },
      "400": { "$value": "oklch(0.800 0.160 65)" },
      "500": { "$value": "oklch(0.772 0.174 65)", "$description": "Anchor ≈ #ff9900 · DBB-Orange (aktive Zustände, dunkler Grund)" },
      "600": { "$value": "oklch(0.670 0.182 50)", "$description": "≈ #eb6909 · Indikator auf hellem Grund (3.2:1)" },
      "700": { "$value": "oklch(0.550 0.150 50)" },
      "800": { "$value": "oklch(0.420 0.110 50)" },
      "900": { "$value": "oklch(0.290 0.070 50)" }
    },
    "neutralDbb": {
      "0": { "$value": "oklch(1.000 0 0)" },
      "50": { "$value": "oklch(0.985 0 0)" },
      "100": { "$value": "oklch(0.967 0 0)" },
      "200": { "$value": "oklch(0.925 0 0)" },
      "300": { "$value": "oklch(0.870 0 0)" },
      "400": { "$value": "oklch(0.700 0 0)" },
      "500": { "$value": "oklch(0.520 0 0)" },
      "600": { "$value": "oklch(0.420 0 0)" },
      "700": { "$value": "oklch(0.320 0 0)" },
      "800": { "$value": "oklch(0.250 0 0)" },
      "900": { "$value": "oklch(0 0 0)", "$description": "#000 · Text wie auf basketball-bund.de" },
      "950": { "$value": "oklch(0.085 0 0)" },
      "1000": { "$value": "oklch(0.213 0 0)", "$description": "#191919 · Anthrazit (Footer, dunkle Flächen)" }
    },
    "role": {
      "bbv": {
        "base": {
          "0": { "$value": "{color.ink.0}" },
          "50": { "$value": "{color.ink.50}" },
          "100": { "$value": "{color.ink.100}" },
          "200": { "$value": "{color.ink.200}" },
          "300": { "$value": "{color.ink.300}" },
          "400": { "$value": "{color.ink.400}" },
          "500": { "$value": "{color.ink.500}" },
          "600": { "$value": "{color.ink.600}" },
          "700": { "$value": "{color.ink.700}" },
          "800": { "$value": "{color.ink.800}" },
          "900": { "$value": "{color.ink.900}" },
          "1000": { "$value": "{color.ink.1000}" }
        },
        "signal": {
          "100": { "$value": "{color.amber.100}" },
          "200": { "$value": "{color.amber.200}" },
          "300": { "$value": "{color.amber.300}" },
          "400": { "$value": "{color.amber.400}" },
          "500": { "$value": "{color.amber.500}" },
          "600": { "$value": "{color.amber.600}" },
          "700": { "$value": "{color.amber.700}" },
          "800": { "$value": "{color.amber.800}" },
          "900": { "$value": "{color.amber.900}" },
          "50": { "$value": "{color.amber.50}" }
        },
        "cool": {
          "100": { "$value": "{color.sky.100}" },
          "200": { "$value": "{color.sky.200}" },
          "300": { "$value": "{color.sky.300}" },
          "400": { "$value": "{color.sky.400}" },
          "500": { "$value": "{color.sky.500}" },
          "600": { "$value": "{color.sky.600}" },
          "700": { "$value": "{color.sky.700}" },
          "800": { "$value": "{color.sky.800}" },
          "900": { "$value": "{color.sky.900}" },
          "50": { "$value": "{color.sky.50}" }
        },
        "action": {
          "bg": { "$value": "{color.ink.900}" },
          "bg2": { "$value": "{color.ink.800}" },
          "bgHover": { "$value": "{color.ink.700}" }
        },
        "indicator": { "$value": "{color.amber.400}" }
      },
      "dbb": {
        "base": {
          "0": { "$value": "{color.neutralDbb.0}" },
          "50": { "$value": "{color.neutralDbb.50}" },
          "100": { "$value": "{color.neutralDbb.100}" },
          "200": { "$value": "{color.neutralDbb.200}" },
          "300": { "$value": "{color.neutralDbb.300}" },
          "400": { "$value": "{color.neutralDbb.400}" },
          "500": { "$value": "{color.neutralDbb.500}" },
          "600": { "$value": "{color.neutralDbb.600}" },
          "700": { "$value": "{color.neutralDbb.700}" },
          "800": { "$value": "{color.neutralDbb.800}" },
          "900": { "$value": "{color.neutralDbb.900}" },
          "1000": { "$value": "{color.neutralDbb.1000}" }
        },
        "signal": {
          "50": { "$value": "{color.gold.50}" },
          "100": { "$value": "{color.gold.100}" },
          "200": { "$value": "{color.gold.200}" },
          "300": { "$value": "{color.gold.300}" },
          "400": { "$value": "{color.gold.400}" },
          "500": { "$value": "{color.gold.500}" },
          "600": { "$value": "{color.gold.600}" },
          "700": { "$value": "{color.gold.700}" },
          "800": { "$value": "{color.gold.800}" },
          "900": { "$value": "{color.gold.900}" }
        },
        "cool": {
          "50": { "$value": "{color.neutralDbb.50}" },
          "100": { "$value": "{color.neutralDbb.100}" },
          "200": { "$value": "{color.neutralDbb.200}" },
          "300": { "$value": "{color.neutralDbb.300}" },
          "400": { "$value": "{color.neutralDbb.400}" },
          "500": { "$value": "{color.neutralDbb.500}" },
          "600": { "$value": "{color.neutralDbb.600}" },
          "700": { "$value": "{color.neutralDbb.700}" },
          "800": { "$value": "{color.neutralDbb.800}" },
          "900": { "$value": "{color.neutralDbb.900}" }
        },
        "action": {
          "bg": { "$value": "{color.neutralDbb.1000}" },
          "bg2": { "$value": "{color.neutralDbb.1000}" },
          "bgHover": { "$value": "{color.neutralDbb.700}" }
        },
        "indicator": { "$value": "{color.orange.600}", "$description": "Auf dunklem Grund color.orange.500" }
      },
      "$description": "Marken-Rollen: Komponenten nutzen nur diese Ebene (CSS: --hoops-base-*, --hoops-signal-*, --hoops-cool-*, --hoops-action-bg*, --hoops-indicator). BBV = Standard, DBB = data-brand=\"dbb\"."
    },
    "team": {
      "heim": { "$value": "{color.sky.700}", "$description": "Default · configurable per match" },
      "gast": { "$value": "oklch(0.520 0.180 25)" }
    }
  },

  "font": {
    "family": {
      "display": { "$value": "Sora, system-ui, sans-serif",       "$description": "Scoreboard, headlines, trikot numbers" },
      "heading": { "$value": "Sora, system-ui, sans-serif" },
      "body":    { "$value": "Manrope, system-ui, sans-serif",    "$description": "UI, body, forms" },
      "mono":    { "$value": "JetBrains Mono, ui-monospace, monospace", "$description": "Game clock, shot clock, tables" }
    },
    "scale": {
      "display":  { "$value": { "size": "88px", "lineHeight": "0.9",  "weight": 800, "tracking": "-0.04em" } },
      "clock":    { "$value": { "size": "64px", "lineHeight": "1",    "weight": 700, "tracking": "-0.02em" } },
      "h1":       { "$value": { "size": "44px", "lineHeight": "1.05", "weight": 700, "tracking": "-0.025em" } },
      "hero":     { "$value": { "size": "32px", "lineHeight": "1.05", "weight": 700, "tracking": "-0.025em" }, "$description": "Name in Hero-Karten" },
      "h2":       { "$value": { "size": "28px", "lineHeight": "1.15", "weight": 600, "tracking": "-0.015em" } },
      "stat":     { "$value": { "size": "22px", "lineHeight": "1.1",  "weight": 800, "tracking": "-0.02em" }, "$description": "Kennzahlen in Karten" },
      "h3":       { "$value": { "size": "20px", "lineHeight": "1.25", "weight": 600, "tracking": "-0.01em" } },
      "body-lg":  { "$value": { "size": "18px", "lineHeight": "1.55", "weight": 400 } },
      "body":     { "$value": { "size": "15px", "lineHeight": "1.55", "weight": 400 } },
      "body-md":  { "$value": { "size": "14px", "lineHeight": "1.5",  "weight": 400 }, "$description": "Kompakte UI: Tabellen, Listen" },
      "body-sm":  { "$value": { "size": "13px", "lineHeight": "1.5",  "weight": 400 } },
      "label":    { "$value": { "size": "12px", "lineHeight": "1.5",  "weight": 600, "transform": "uppercase", "tracking": "0.04em" } },
      "caption":  { "$value": { "size": "11px", "lineHeight": "1.4",  "weight": 600, "transform": "uppercase", "tracking": "0.06em" }, "$description": "Mono-Beschriftung, Chips, Meta" }
    }
  },

  "spacing": {
    "0":  { "$value": "0" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },

  "radius": {
    "none": { "$value": "0" },
    "sm":   { "$value": "4px",   "$description": "chips, mini badges" },
    "md":   { "$value": "8px",   "$description": "inputs, fields" },
    "lg":   { "$value": "12px",  "$description": "cards" },
    "xl":   { "$value": "18px",  "$description": "panels, modals" },
    "full": { "$value": "999px", "$description": "avatars, pills" }
  },

  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(15,20,38,0.08)" },
    "md": { "$value": "0 4px 12px rgba(15,20,38,0.08), 0 1px 3px rgba(15,20,38,0.04)" },
    "lg": { "$value": "0 18px 48px rgba(15,20,38,0.16), 0 4px 12px rgba(15,20,38,0.08)" },
    "xl": { "$value": "0 30px 80px -10px rgba(15,20,38,0.30), 0 12px 30px -8px rgba(15,20,38,0.18)" }
  },

  "size": {
    "touch": {
      "sm": { "$value": "44px", "$description": "WCAG minimum" },
      "md": { "$value": "56px", "$description": "Default web" },
      "lg": { "$value": "64px", "$description": "Gymnasium-grade" }
    },
    "field": {
      "touch":   { "$value": "56px" },
      "default": { "$value": "44px" },
      "compact": { "$value": "36px" }
    },
    "row": {
      "touch":   { "$value": "60px" },
      "default": { "$value": "44px" },
      "compact": { "$value": "36px" },
      "dense":   { "$value": "30px" }
    }
  },

  "breakpoint": {
    "mobile":  { "$value": "640px" },
    "tablet":  { "$value": "1024px", "$description": "iPad landscape — main Kampfgericht device" },
    "desktop": { "$value": "1280px" }
  },

  "validation": {
    "trikotnummer": {
      "$value": "^(0|00|0?[1-9]|[1-9][0-9])$",
      "$description": "FIBA: 0, 00, einstellig (1-9), zweistellig (01-09, 10-99). 7 ≠ 07."
    },
    "lizenz-sr": { "$value": "^SR-\\d{4}-\\d{4}$" },
    "lizenz-kg": { "$value": "^KG-\\d{4}-\\d{4}$" }
  }
}
